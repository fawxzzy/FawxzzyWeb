        {
          "id": "FF-SESSION-001",
          "sourceProjectId": "fitness",
          "component": null,
          "sourceRevision": "sha256:041d8ee0c428d346745b930d66f9234a8a1a5f9fb188a778cee47137ce989434",
          "owner": "fitness",
          "title": "Add Per-Exercise Exercise Timer System",
          "summary": "Add a deterministic per-exercise timer system to session logging for exercises the user wants to time while they are actively performing them. The timer should be optional when an exercise is added, belong to the session exercise rather than the whole workout, appear during Current Session logging when enabled, and persist bounded timer outcomes for later analytics and history reuse.",
          "lifecycle": "review",
          "workType": "feature",
          "priority": null,
          "dependencies": [],
          "parentId": null,
          "duplicateOf": null,
          "supersededBy": null,
          "updatedAt": "2026-07-15T20:22:00.000Z"
        },
        {
          "id": "FF-SESSION-002",
          "sourceProjectId": "fitness",
          "component": null,
          "sourceRevision": "sha256:041d8ee0c428d346745b930d66f9234a8a1a5f9fb188a778cee47137ce989434",
          "owner": "fitness",
          "title": "Add Exercise Timer Toggle When Adding an Exercise",
          "summary": "Add a switch control in the add-exercise flow that enables or disables an exercise timer for that exercise in the current session. If enabled, the add flow should support a bounded timer configuration such as a target duration or timer mode. If disabled, the exercise should behave exactly like today with no timer UI added later in session logging.",
          "lifecycle": "review",
          "workType": "feature",
          "priority": null,
          "dependencies": [
            "FF-SESSION-001"
          ],
          "parentId": null,
          "duplicateOf": null,
          "supersededBy": null,
          "updatedAt": "2026-07-13T04:33:22.350Z"
        },
        {
          "id": "FF-SESSION-003",
          "sourceProjectId": "fitness",
          "component": null,
          "sourceRevision": "sha256:041d8ee0c428d346745b930d66f9234a8a1a5f9fb188a778cee47137ce989434",
          "owner": "fitness",
          "title": "Show Live Per-Exercise Timer During Current Session Logging",
          "summary": "When a timer-enabled exercise is open in Current Session, show the timer control in the logger surface for that exercise. The user should be able to start, pause, resume, reset, or dismiss the timer while performing the exercise without affecting the saved set truth. If a target duration exists, completion should surface a clear done-state cue for that exercise.",
          "lifecycle": "review",
          "workType": "feature",
          "priority": null,
          "dependencies": [
            "FF-SESSION-002"
          ],
          "parentId": null,
          "duplicateOf": null,
          "supersededBy": null,
          "updatedAt": "2026-07-13T04:33:22.350Z"
        },
        {
          "id": "FF-SESSION-004",
          "sourceProjectId": "fitness",
          "component": null,
          "sourceRevision": "sha256:041d8ee0c428d346745b930d66f9234a8a1a5f9fb188a778cee47137ce989434",
          "owner": "fitness",
          "title": "Persist Exercise Timer Outcomes Into Session Analytics",
          "summary": "Persist exercise-timer configuration and usable outcome data into session truth. At minimum, store whether the exercise used a timer, the configured timer target or mode when present, and enough completed timing data to support later summaries and comparisons. This must survive session completion and be available to history-family loaders without reconstructing timer behavior from fragile client-only state.",
          "lifecycle": "review",
          "workType": "feature",
          "priority": null,
          "dependencies": [
            "FF-SESSION-003"
          ],
          "parentId": null,
          "duplicateOf": null,
          "supersededBy": null,
          "updatedAt": "2026-07-13T04:33:22.350Z"
        },
        {
          "id": "FF-SESSION-005",
          "sourceProjectId": "fitness",
          "component": null,
          "sourceRevision": "sha256:041d8ee0c428d346745b930d66f9234a8a1a5f9fb188a778cee47137ce989434",
          "owner": "fitness",
          "title": "Add Separate Recovery And Rest Recommendation Layer",
          "summary": "Add a separate backend and product lane for recovery summaries, rest recommendations, and next-set prompts. This may use set timestamps, session history, and any later bounded timing truth, but it must remain a separate concern from the toggleable exercise timer feature. The app can later surface deterministic guidance such as likely rest windows or recovery patterns without redefining the user-facing exercise timer as a rest timer.",
          "lifecycle": "review",
          "workType": "feature",
          "priority": null,
          "dependencies": [
            "FF-SESSION-004"
          ],
          "parentId": null,
          "duplicateOf": null,
          "supersededBy": null,
          "updatedAt": "2026-07-13T04:33:22.350Z"
        },
